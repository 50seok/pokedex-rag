# 이 파일은 "키 이름만" 담습니다. 실제 값은 .env 에 넣고, .env 는 커밋하지 않습니다.
# 사용법: cp .env.example .env  후 값을 채워 넣으세요.

# Google Gemini API 키 — https://aistudio.google.com/apikey 에서 발급 (신용카드 불필요)
GEMINI_API_KEY=

# 로컬 개발 DB (docker-compose 로 띄우는 pgvector 컨테이너)
DATABASE_URL=jdbc:postgresql://localhost:5432/pokedex
DATABASE_USERNAME=pokedex
DATABASE_PASSWORD=

# local | prod
SPRING_PROFILES_ACTIVE=local
